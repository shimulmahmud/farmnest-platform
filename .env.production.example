# Copy to ".env.production" and fill in EVERY line marked REQUIRED.
# Keep this file private (never commit it, never email it).

# --- REQUIRED: your two addresses (DNS "A" records must point at this server) ---
SHOP_DOMAIN=shop.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- REQUIRED: secrets. Make them with:  openssl rand -hex 32
# Use only letters and numbers (a hex string is perfect).
JWT_SECRET=
MONGO_PASSWORD=
MONGO_USER=shop

# --- REQUIRED: email provider (Amazon SES, Brevo, SendGrid, Mailgun...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
SMTP_STARTTLS=true

# --- Shop look (shown in emails and the admin panel) ---
APP_NAME=FarmNest
SUPPORT_EMAIL=
BRAND_LOGO_URL=
BRAND_COLOR=#1f5c3a

# --- Wallets customers pay to at checkout (leave empty to hide) ---
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=

# --- Backups ---
BACKUP_KEEP_DAYS=14
