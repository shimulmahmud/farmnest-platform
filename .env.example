# Copy this file to ".env" to change settings. Everything has a working default.

# Ports on your computer
CLIENT_PORT=5174
ADMIN_PORT=5173
API_PORT=8080

# Wallets customers send money to at checkout (leave empty to hide a wallet)
PAYMENT_BKASH_NUMBER=01700000000
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=

# Public address of the storefront, used for share tags and sitemap (production only)
SITE_URL=

# Emails (sign-up verification, password reset, order updates, support replies)
APP_NAME=FarmNest
# Where the buttons in emails open. In production use your real addresses.
APP_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173
SUPPORT_EMAIL=
# Optional logo shown at the top of emails (full https:// address) and the button colour
BRAND_LOGO_URL=
BRAND_COLOR=#1f5c3a
