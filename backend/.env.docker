# ============================================================
# Docker Compose Environment Variables
# ============================================================

APP_ENV=development

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---- MongoDB ----
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ecommerce

# ---- NATS ----
NATS_URL=nats://nats:4222
NATS_CLUSTER_NAME=ecommerce-cluster

# ---- Transactional email (Mailpit in local Docker) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@ecommerce.local
SMTP_STARTTLS=false
SMTP_TIMEOUT=10s

# ---- Logging ----
LOG_LEVEL=debug
LOG_ENCODING=json

# ---- Security ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
RATE_LIMIT_PER_MINUTE=200

# ---- JWT (>= 32 chars) ----
JWT_SECRET=dev-secret-key-for-local-docker-testing-only-not-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_ISSUER=ecommerce-api

# ---- Observability ----
OTEL_SERVICE_NAME=ecommerce-api
OTEL_ENABLED=true
OTEL_PROMETHEUS_PORT=9090

# ---- Webhook Secrets ----
WEBHOOK_SECRET_FAKE=fake-webhook-secret-for-testing

# Wallets customers pay to at checkout (leave empty to hide)
PAYMENT_BKASH_NUMBER=01700000000
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
