# ============================================================
# Environment — Development
# ============================================================
# Copy to .env and adjust as needed.
# NEVER commit real secrets to version control.
# ============================================================

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ecommerce
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# NATS
NATS_URL=nats://nats:4222
NATS_CLUSTER_NAME=ecommerce-cluster

# JWT — 32+ character secret for dev/testing
JWT_SECRET=dev-secret-key-do-not-use-in-production-32ch
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_ISSUER=ecommerce-api

# Logging
LOG_LEVEL=debug
LOG_ENCODING=json

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

# Observability
OTEL_SERVICE_NAME=ecommerce-api
OTEL_ENABLED=false
OTEL_PROMETHEUS_PORT=9090
