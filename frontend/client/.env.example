# Public site URL (no trailing slash). Used for canonical URLs, social-share tags and sitemap.xml.
VITE_SITE_URL=https://www.example.com.bd

# Backend API.
# Development: leave empty. The dev server forwards /api to http://localhost:8080 (change with VITE_PROXY_TARGET).
# Production: the public API address, e.g. https://api.example.com/api/v1
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:8080
